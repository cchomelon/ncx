netcdf curvilinear {
dimensions:
  time = 3 ;
  y = 4 ;
  x = 5 ;
variables:
  float time(time) ;
    time:standard_name = "time" ;
    time:axis = "T" ;
    time:units = "hours since 2024-07-25 00:00:00 UTC" ;
  float lon(y, x) ;
    lon:standard_name = "longitude" ;
    lon:units = "degrees_east" ;
    lon:_FillValue = -999.f ;
  float lat(y, x) ;
    lat:standard_name = "latitude" ;
    lat:units = "degrees_north" ;
  float sea_temperature(time, y, x) ;
    sea_temperature:long_name = "Curvilinear sea temperature" ;
    sea_temperature:units = "degree_Celsius" ;
    sea_temperature:coordinates = "lon lat" ;
    sea_temperature:_FillValue = -999.f ;

data:
  time = 0, 6, 12 ;
  lon =
    110, 111, 112, 113, 114,
    109.8, 110.9, 112, 113.1, 114.2,
    109.6, 110.8, 112, 113.2, 114.4,
    109.4, 110.7, 112, 113.3, _ ;
  lat =
    20, 20.1, 20.15, 20.1, 20,
    21, 21.1, 21.15, 21.1, 21,
    22, 22.1, 22.15, 22.1, 22,
    23, 23.1, 23.15, 23.1, 23 ;
  sea_temperature =
    21, 21.2, 21.5, 21.9, 22.1,
    21.3, 21.7, 22.2, 22.5, 22.7,
    21.6, 22, 22.6, 23, 23.2,
    21.8, 22.3, 22.8, 23.3, 23.5,
    22, 22.2, 22.5, 22.9, 23.1,
    22.3, 22.7, 23.2, 23.5, 23.7,
    22.6, 23, 23.6, 24, 24.2,
    22.8, 23.3, 23.8, 24.3, 24.5,
    23, 23.2, 23.5, 23.9, 24.1,
    23.3, 23.7, 24.2, 24.5, 24.7,
    23.6, 24, 24.6, 25, 25.2,
    23.8, 24.3, 24.8, 25.3, _ ;
}
