netcdf groups {
group: east {
  dimensions:
    y = 2 ;
    x = 2 ;
  variables:
    float y(y) ;
      y:axis = "Y" ;
    float x(x) ;
      x:axis = "X" ;
    float temperature(y, x) ;
      temperature:coordinates = "x y" ;
  data:
    y = 20, 21 ;
    x = 110, 111 ;
    temperature = 1, 2, 3, 4 ;
  }

group: west {
  dimensions:
    y = 2 ;
    x = 3 ;
  variables:
    float y(y) ;
      y:axis = "Y" ;
    float x(x) ;
      x:axis = "X" ;
    float temperature(y, x) ;
      temperature:coordinates = "x y" ;
  data:
    y = 30, 31 ;
    x = 120, 121, 122 ;
    temperature = 5, 6, 7, 8, 9, 10 ;
  }
}
