netcdf rectilinear {
dimensions:
  time = UNLIMITED ; // (4 currently)
  lat = 6 ;
  lon = 8 ;
variables:
  float time(time) ;
    time:standard_name = "time" ;
    time:axis = "T" ;
    time:units = "hours since 2024-07-25 00:00:00 +08:00" ;
  float lat(lat) ;
    lat:standard_name = "latitude" ;
    lat:axis = "Y" ;
    lat:units = "degrees_north" ;
  float lon(lon) ;
    lon:standard_name = "longitude" ;
    lon:axis = "X" ;
    lon:units = "degrees_east" ;
  short temperature(time, lat, lon) ;
    temperature:long_name = "Potential temperature" ;
    temperature:units = "K" ;
    temperature:coordinates = "lon lat" ;
    temperature:_FillValue = -9999s ;
    temperature:scale_factor = 0.1f ;
    temperature:add_offset = 273.15f ;
  float reference_pressure ;
    reference_pressure:long_name = "Reference pressure" ;
    reference_pressure:units = "Pa" ;

// global attributes:
  :title = "ncx deterministic browser fixture" ;

data:
  time = 0, 6, 12, 18 ;
  lat = 20, 21, 22, 23, 24, 25 ;
  lon = 110, 111, 112, 113, 114, 115, 116, 117 ;
  reference_pressure = 101325 ;
  temperature =
    -40, -38, -36, -34, -32, -30, -28, -26,
    -30, -28, -26, -24, -22, -20, -18, -16,
    -20, -18, -16, -14, -12, -10, -8, -6,
    -10, -8, -6, -4, -2, 0, 2, 4,
    0, 2, 4, 6, 8, 10, 12, 14,
    10, 12, 14, 16, 18, 20, 22, 24,
    60, 62, 64, 66, 68, 70, 72, 74,
    70, 72, 74, 76, 78, 80, 82, 84,
    80, 82, 84, 86, 88, 90, 92, 94,
    90, 92, 94, 96, 98, -9999, 102, 104,
    100, 102, 104, 106, 108, 110, 112, 114,
    110, 112, 114, 116, 118, 120, 122, 124,
    160, 162, 164, 166, 168, 170, 172, 174,
    170, 172, 174, 176, 178, 180, 182, 184,
    180, 182, 184, 186, 188, 190, 192, 194,
    190, 192, 194, 196, 198, 200, 202, 204,
    200, 202, 204, 206, 208, 210, 212, 214,
    210, 212, 214, 216, 218, 220, 222, 224,
    260, 262, 264, 266, 268, 270, 272, 274,
    270, 272, 274, 276, 278, 280, 282, 284,
    280, 282, 284, 286, 288, 290, 292, 294,
    290, 292, 294, 296, 298, 300, 302, 304,
    300, 302, 304, 306, 308, 310, 312, 314,
    310, 312, 314, 316, 318, 320, 322, 324 ;
}
